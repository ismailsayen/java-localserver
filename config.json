[
  {
    "name": "primary.local",
    "host": "127.0.0.1",
    "port": [8081,8023],
    "defaultServer": true,
    "limitSize": 1024,
    "routes": [
      {
        "path": "/",
        "root": "./www/html/primary",
        "methods": ["GET"],
        "index": "index.html"
      },
      {
        "path": "/cgi-bin",
        "root": "./www/scripts",
        "methods": ["GET", "POST"],
        "cgiExtension": ".py"
      },
      {
        "path": "/www",
        "root": "./www/html/primary",
        "methods": ["GET"],
        "index": "index.html"
      },
      {
        "path": "/www",
        "root": "./www/html/primary",
        "methods": ["GET"],
        "directoryListening": true
      }
    ]
  }
]
