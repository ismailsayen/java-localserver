[
  {
    "name": "primary.local",
    "host": "127.0.0.1",
    "port": [
      8081,
      8023,
      8082,
      8084,
      8088,
      8092
    ],
    "defaultServer": true,
    "limitSize": 1024,
    "errorPages": {
      "404": "./custom_error_pages/404.html",
      "403": "./custom_error_pages/403.html"
    },
    "routes": [
      {
        "path": "/",
        "root": "./www/html/primary",
        "methods": [
          "GET"
        ],
        "index": "index.html"
      },
      {
        "path": "/uploads",
        "root": "./www/uploads",
        "methods": [
          "GET",
          "POST",
          "DELETE"
        ]
      },
      {
        "path": "/cgi-bin",
        "root": "./www/scripts",
        "methods": [
          "GET",
          "POST"
        ],
        "cgiExtension": ".py"
      },
      {
        "path": "/redirect",
        "methods": [
          "GET"
        ],
        "redirectTo": "/www",
        "redirectStatusCode": 302
      },
      {
        "path": "/www",
        "root": "./www/",
        "methods": [
          "GET",
          "DELETE"
        ],
        "directoryListing": true
      }
    ]
  }
]