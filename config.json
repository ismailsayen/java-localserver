      "500": "./custom_error_pages/500.html"
    },
    "routes": [
      {
        "path": "/",
        "root": "./www/html/primary",
        "methods": ["GET"],
        "index": "index.html"
      },
      {
        "path": "/uploads",
        "root": "./www/uploads",
        "methods": ["GET", "POST", "DELETE"]
      },
      {
        "path": "/cgi-bin",
        "root": "./www/scripts",
        "methods": ["GET", "POST"],
        "cgiExtension": ".py"
      },
      {
        "path": "/redirect",
        "methods": ["GET"],
        "redirectTo": "/www",
        "redirectStatusCode": 302
      },
      {
        "path": "/www",
        "root": "./www/",
        "methods": ["GET", "DELETE"],
        "directoryListing": true
      }
    ]
  },
